NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/alfred
MONGODB_DB_NAME=alfred

REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Production normally uses secure=true.
# Cross-site frontend/API requires sameSite=none and secure=true.
# Same-site subdomains should prefer strict or lax.
AUTH_REFRESH_COOKIE_NAME=alfred_refresh_token
AUTH_REFRESH_COOKIE_PATH=/auth
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SAME_SITE=lax
AUTH_REFRESH_COOKIE_SECURE=false

ENCRYPTION_KEY=change_this_32_byte_key_value

LLM_MOCK_MODE=true

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

DEFAULT_MAX_WORKFLOW_ITERATIONS=3
DEFAULT_WORKFLOW_BUDGET_USD=5
DEFAULT_MAX_TOKENS_PER_RUN=100000

LOG_LEVEL=debug
