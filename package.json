{
  "name": "alfred-command-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "npm run dev:infra && concurrently -n backend,frontend -c blue,magenta \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:infra": "node scripts/dev-infra.js",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "next dev",
    "build": "next build",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "next build",
    "build:all": "npm run build && npm run build:backend",
    "start": "next start",
    "lint": "next lint",
    "seed": "npm --prefix backend run seed",
    "indexes": "npm --prefix backend run indexes",
    "test": "npm run typecheck && npm run test:frontend",
    "test:frontend": "node scripts/frontend-checks.mjs",
    "test:backend": "npm --prefix backend run test",
    "test:e2e": "npm run dev:infra && npm --prefix backend run test:e2e",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:frontend",
    "check:backend": "npm --prefix backend run lint && npm --prefix backend run typecheck && npm run build:backend && npm run test:backend",
    "check:all": "npm run check && npm run check:backend"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "next": "^14.2.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
